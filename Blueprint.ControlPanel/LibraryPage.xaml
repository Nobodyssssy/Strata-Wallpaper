<Page
    x:Class="Blueprint.ControlPanel.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Blueprint.ControlPanel"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24,20,24,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ Title ═══════════ -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Wallpapers" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="Manage your library, preview and set your favorite wallpapers."
                       FontSize="13"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- ═══════════ Toolbar ═══════════ -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <AutoSuggestBox x:Name="SearchBox"
                            Grid.Column="0"
                            MaxWidth="380"
                            HorizontalAlignment="Left"
                            PlaceholderText="Search wallpapers..."
                            QueryIcon="Find"
                            TextChanged="OnSearchChanged"/>

            <ComboBox x:Name="SortCombo"
                      Grid.Column="1"
                      MinWidth="200"
                      SelectionChanged="OnSortChanged"
                      VerticalAlignment="Center">
                <ComboBoxItem Content="Name (A → Z)"/>
                <ComboBoxItem Content="Name (Z → A)"/>
                <ComboBoxItem Content="Recently added"/>
                <ComboBoxItem Content="Recently applied"/>
                <ComboBoxItem Content="Favorites first"/>
                <ComboBoxItem Content="Duration (shortest)"/>
                <ComboBoxItem Content="Resolution (smallest)"/>
                <ComboBoxItem Content="File size (smallest)"/>
                <ComboBoxItem Content="Recently modified"/>
            </ComboBox>

            <Button Grid.Column="2" Click="OnRefreshClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                    <TextBlock Text="Refresh" FontSize="12"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="3" Click="OnAddFolderClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8F4;" FontSize="13"/>
                    <TextBlock Text="Add Folder" FontSize="12"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ═══════════ Filter chips ═══════════ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <ToggleButton x:Name="ChipAll"       Content="All"       Tag="all"       IsChecked="True" Click="OnFilterChipClick"
                          Padding="14,4" CornerRadius="14" FontSize="12"/>
            <ToggleButton x:Name="ChipVideo"     Content="Video"     Tag="video"     Click="OnFilterChipClick"
                          Padding="14,4" CornerRadius="14" FontSize="12"/>
            <ToggleButton x:Name="ChipLive2D"    Content="Live2D"    Tag="live2d"    Click="OnFilterChipClick"
                          Padding="14,4" CornerRadius="14" FontSize="12"/>
            <ToggleButton x:Name="ChipFavorites" Content="Favorites" Tag="favorites" Click="OnFilterChipClick"
                          Padding="14,4" CornerRadius="14" FontSize="12"/>
            <ToggleButton x:Name="ChipAssigned"  Content="Assigned"  Tag="assigned"  Click="OnFilterChipClick"
                          Padding="14,4" CornerRadius="14" FontSize="12"/>

            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- ═══════════ Grid + sidebar ═══════════ -->
        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Wallpaper grid -->
            <Grid Grid.Column="0">
                <StackPanel x:Name="EmptyState"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="10"
                            Visibility="Collapsed">
                    <FontIcon Glyph="&#xE8B7;" FontSize="48"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="No wallpapers here" FontSize="16" HorizontalAlignment="Center"/>
                    <TextBlock Text="Try a different filter or add a folder."
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <GridView x:Name="WallpaperGrid"
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          ItemClick="OnWallpaperItemClick">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"
                                           ItemWidth="240"
                                           ItemHeight="220"/>
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>

                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="local:WallpaperItem">
                            <Grid Margin="4" Width="232" Height="212">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Thumbnail + overlays -->
                                <Border Grid.Row="0"
                                        CornerRadius="10,10,0,0"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <Grid>
                                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}"
                                               Stretch="UniformToFill"/>

                                        <!-- Loading placeholder -->
                                        <ProgressRing IsActive="True"
                                                      Width="32" Height="32"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Visibility="{x:Bind LoadingVisibility, Mode=OneWay}"/>

                                        <!-- Missing-file overlay (below interactives) -->
                                        <Border Background="#B3000000"
                                                Visibility="{x:Bind MissingOverlayVisibility, Mode=OneWay}">
                                            <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Spacing="4">
                                                <FontIcon Glyph="&#xE7BA;" FontSize="26" Foreground="#FF7C7C"/>
                                                <TextBlock Text="File missing"
                                                           FontSize="11"
                                                           HorizontalAlignment="Center"
                                                           Foreground="White"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Live2D badge -->
                                        <Border HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Margin="8"
                                                Padding="6,2"
                                                CornerRadius="4"
                                                Background="#CC00C8B4"
                                                Visibility="{x:Bind Live2DBadgeVisibility, Mode=OneWay}">
                                            <TextBlock Text="Live2D" FontSize="10" Foreground="White"/>
                                        </Border>

                                        <!-- Favorite star -->
                                        <Button HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="8"
                                                Padding="8"
                                                CornerRadius="16"
                                                Background="#AA000000"
                                                BorderThickness="0"
                                                Tag="{x:Bind}"
                                                Click="OnFavoriteClick"
                                                ToolTipService.ToolTip="Toggle favorite">
                                            <FontIcon Glyph="{x:Bind FavoriteGlyph, Mode=OneWay}"
                                                      FontSize="16"
                                                      Foreground="{x:Bind FavoriteColor, Mode=OneWay}"/>
                                        </Button>

                                        <!-- Assignment badges -->
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="4"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Bottom"
                                                    Margin="8">
                                            <Border Padding="5,2" CornerRadius="3"
                                                    Background="#CC0A84FF"
                                                    Visibility="{x:Bind M1BadgeVisibility, Mode=OneWay}">
                                                <TextBlock Text="M1" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                            </Border>
                                            <Border Padding="5,2" CornerRadius="3"
                                                    Background="#CC0A84FF"
                                                    Visibility="{x:Bind M2BadgeVisibility, Mode=OneWay}">
                                                <TextBlock Text="M2" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                            </Border>
                                            <Border Padding="5,2" CornerRadius="3"
                                                    Background="#CC0A84FF"
                                                    Visibility="{x:Bind BothBadgeVisibility, Mode=OneWay}">
                                                <TextBlock Text="Both" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                            </Border>
                                            <Border Padding="5,2" CornerRadius="3"
                                                    Background="#CCE72E5A"
                                                    Visibility="{x:Bind LockBadgeVisibility, Mode=OneWay}">
                                                <TextBlock Text="Lock" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Footer: name + compact meta -->
                                <Border Grid.Row="1"
                                        Padding="10,8"
                                        CornerRadius="0,0,10,10"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind DisplayName}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1"/>
                                        <TextBlock Text="{x:Bind MetaLine, Mode=OneWay}"
                                                   FontSize="10"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>

            <!-- Right column: settings sidebar OR detail pane -->
            <Border x:Name="SidebarBorder"
                    Grid.Column="1"
                    CornerRadius="10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="16" Spacing="14">

                        <!-- Empty state -->
                        <StackPanel x:Name="SidebarNoSelection"
                                    Spacing="8"
                                    Padding="0,40,0,0">
                            <FontIcon Glyph="&#xE7C5;"
                                      FontSize="32"
                                      HorizontalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="Select a wallpaper"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Choose a tile to preview it and apply it to a target."
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <!-- Selected wallpaper content -->
                        <StackPanel x:Name="SidebarContent"
                                    Spacing="14"
                                    Visibility="Collapsed">

                            <StackPanel Spacing="2">
                                <TextBlock x:Name="SidebarFileName"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="SidebarFileMeta"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <Border CornerRadius="8"
                                    Height="120"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <Image x:Name="SidebarPreview" Stretch="UniformToFill"/>
                            </Border>

                            <!-- Missing file warning -->
                            <Border x:Name="MissingFileWarning"
                                    Visibility="Collapsed"
                                    Padding="10"
                                    CornerRadius="6"
                                    Background="#33FF6B6B"
                                    BorderBrush="#FFFF6B6B"
                                    BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="#FF7C7C"/>
                                        <TextBlock Text="File not found"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Text="This file has moved or been deleted. Point Strata at its new location to keep it in the library."
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <Button Content="Locate file…"
                                            Click="OnLocateFileClick"
                                            HorizontalAlignment="Left"
                                            Padding="10,4"
                                            FontSize="11"/>
                                </StackPanel>
                            </Border>

                            <!-- Scope: Desktop / Lock Screen -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="Apply to"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Border CornerRadius="6"
                                        Padding="2"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Grid ColumnSpacing="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton x:Name="ScopeDesktop"
                                                      Grid.Column="0"
                                                      Content="Desktop"
                                                      Tag="desktop"
                                                      IsChecked="True"
                                                      Click="OnScopeClick"
                                                      HorizontalAlignment="Stretch"
                                                      HorizontalContentAlignment="Center"
                                                      CornerRadius="4"
                                                      Padding="0,6"
                                                      MinWidth="0"/>
                                        <ToggleButton x:Name="ScopeLock"
                                                      Grid.Column="1"
                                                      Content="Lock Screen"
                                                      Tag="lock"
                                                      Click="OnScopeClick"
                                                      HorizontalAlignment="Stretch"
                                                      HorizontalContentAlignment="Center"
                                                      CornerRadius="4"
                                                      Padding="0,6"
                                                      MinWidth="0"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Monitor target row (shared: Desktop + Lock) -->
                            <StackPanel x:Name="MonitorTargetsSection" Spacing="6">
                                <TextBlock x:Name="TargetSectionLabel"
                                           Text="Monitor target"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Grid ColumnSpacing="6" RowSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <ToggleButton x:Name="TargetM1"
                                                  Grid.Row="0" Grid.Column="0"
                                                  Content="Monitor 1"
                                                  Tag="0"
                                                  Click="OnTargetClick"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Center"
                                                  Padding="0,8"/>
                                    <ToggleButton x:Name="TargetM2"
                                                  Grid.Row="0" Grid.Column="1"
                                                  Content="Monitor 2"
                                                  Tag="1"
                                                  Click="OnTargetClick"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Center"
                                                  Padding="0,8"/>
                                    <ToggleButton x:Name="TargetBoth"
                                                  Grid.Row="1" Grid.Column="0"
                                                  Content="Both"
                                                  Tag="all"
                                                  Click="OnTargetClick"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Center"
                                                  Padding="0,8"/>
                                    <ToggleButton x:Name="TargetSpan"
                                                  Grid.Row="1" Grid.Column="1"
                                                  Content="Span"
                                                  Tag="span"
                                                  IsEnabled="False"
                                                  Click="OnTargetClick"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Center"
                                                  Padding="0,8"
                                                  ToolTipService.ToolTip="Coming soon"/>
                                </Grid>
                                <TextBlock x:Name="SpanHint"
                                           Text="Span (one continuous image across all monitors) is coming soon."
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <!-- Single apply button -->
                            <Button x:Name="ApplyButton"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="OnApplyClick"
                                    Padding="0,10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE768;" FontSize="14"/>
                                    <TextBlock x:Name="ApplyButtonText"
                                               Text="Apply to Both monitors"
                                               FontSize="13"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="PreviewButton"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Click="OnPreviewClick"
                                    Padding="0,10"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7B3;" FontSize="14"/>
                                    <TextBlock x:Name="PreviewButtonText"
                                               Text="Preview"
                                               FontSize="13"/>
                                </StackPanel>
                            </Button>

                            <!-- Confirmation / error line -->
                            <TextBlock x:Name="ApplyStatusText"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed"/>

                            <!-- Details -->
                            <Button HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Click="OnShowDetailsClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE946;" FontSize="13"/>
                                    <TextBlock Text="View details" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <local:WallpaperDetailPane x:Name="DetailPane"
                                       Grid.Column="1"
                                       Visibility="Collapsed"/>
        </Grid>

        <!-- Custom Preview Overlay -->
        <Grid x:Name="PreviewOverlay"
              Grid.RowSpan="4"
              Visibility="Collapsed"
              Background="#CC000000"
              Canvas.ZIndex="100">
            <!-- 16:9 Dialog Box -->
            <Border Width="960" Height="540"
                    Background="#111111"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="#333333">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Padding="16,12" Background="#1A1A1A" CornerRadius="12,12,0,0">
                        <TextBlock x:Name="PreviewOverlayTitle" Text="Preview" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                    </Grid>

                    <!-- Video area -->
                    <Grid Grid.Row="1" Background="Black">
                        <MediaPlayerElement x:Name="PreviewMediaPlayer"
                                            AreTransportControlsEnabled="False"
                                            AutoPlay="True"
                                            Stretch="UniformToFill"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"/>

                        <!-- Monitor Label -->
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                                Padding="8,4" CornerRadius="4" Background="#AA000000">
                            <TextBlock x:Name="PreviewOverlayLabel" Text="Monitor" FontSize="11" Foreground="White"/>
                        </Border>

                        <!-- Clock overlay -->
                        <Grid x:Name="PreviewOverlayClock" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <!-- 350 / 1080 = 32.4% from the top -->
                                <RowDefinition Height="32.4*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="67.6*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="PreviewOverlayTime" Text="12:00" 
                                           FontSize="56" FontWeight="SemiBold" 
                                           Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="PreviewOverlayDate" Text="Monday, April 28" 
                                           FontSize="16" Foreground="White" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Footer with Close button -->
                    <Grid Grid.Row="2" Padding="16" Background="#1A1A1A" CornerRadius="0,0,12,12">
                        <Button Content="Close"
                                HorizontalAlignment="Center"
                                Padding="48,8"
                                Click="OnPreviewOverlayCloseClick"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>