<Page
    x:Class="Blueprint.ControlPanel.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Blueprint.ControlPanel"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24,20,24,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ Title ═══════════ -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Wallpapers" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="Manage your library, preview and set your favorite wallpapers."
                       FontSize="13"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- ═══════════ Toolbar ═══════════ -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="6" Padding="2" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <ToggleButton x:Name="ViewGalleryToggle" Content="Gallery" IsChecked="True" Click="OnViewToggleClick" Tag="gallery" Padding="12,6" CornerRadius="4" Style="{StaticResource AccentToggleButtonStyle}"/>
                    <ToggleButton x:Name="ViewFolderToggle" Content="Folders" Click="OnViewToggleClick" Tag="folder" Padding="12,6" CornerRadius="4" Style="{StaticResource AccentToggleButtonStyle}"/>
                </StackPanel>
            </Border>

            <AutoSuggestBox x:Name="SearchBox"
                            Grid.Column="1"
                            MaxWidth="380"
                            HorizontalAlignment="Left"
                            PlaceholderText="Search wallpapers..."
                            QueryIcon="Find"
                            TextChanged="OnSearchChanged"/>

            <ComboBox x:Name="SortCombo" Grid.Column="2" MinWidth="160" SelectionChanged="OnSortChanged" VerticalAlignment="Center">
                <ComboBoxItem Content="Name (A → Z)"/>
                <ComboBoxItem Content="Name (Z → A)"/>
                <ComboBoxItem Content="Date Added"/>
                <ComboBoxItem Content="Favorites first"/>
                <ComboBoxItem Content="Resolution (High → Low)"/>
                <ComboBoxItem Content="Duration (Short → Long)"/>
                <ComboBoxItem Content="File Size (Small → Large)"/>
            </ComboBox>

                    <Button Grid.Column="3" Click="OnRefreshClick" Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                    <TextBlock Text="Refresh" FontSize="12"/>
                </StackPanel>
            </Button>

                    <Button Grid.Column="4" Click="OnAddFolderClick" Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8F4;" FontSize="13"/>
                    <TextBlock Text="Add Folder" FontSize="12"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ═══════════ Breadcrumb (Folder View Only) ═══════════ -->
        <BreadcrumbBar x:Name="FolderBreadcrumb" Grid.Row="2" Visibility="Collapsed" ItemClicked="OnBreadcrumbClicked" Margin="0,8,0,0">
            <BreadcrumbBar.ItemTemplate>
                <DataTemplate x:DataType="local:BreadcrumbNode">
                    <TextBlock Text="{x:Bind Name}"/>
                </DataTemplate>
            </BreadcrumbBar.ItemTemplate>
        </BreadcrumbBar>

        <!-- ═══════════ Filter chips ═══════════ -->
        <StackPanel x:Name="FilterChips" Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <ToggleButton x:Name="ChipAll"       Content="All"       Tag="all"       IsChecked="True" Click="OnFilterChipClick"
                          Padding="14,4" CornerRadius="14" FontSize="12"/>
            <ToggleButton x:Name="ChipVideo"     Content="Video"     Tag="video"     Click="OnFilterChipClick"
                          Padding="14,4" CornerRadius="14" FontSize="12"/>
            <ToggleButton x:Name="ChipLive2D"    Content="Live2D"    Tag="live2d"    Click="OnFilterChipClick"
                          Padding="14,4" CornerRadius="14" FontSize="12"/>
            <ToggleButton x:Name="ChipFavorites" Content="Favorites" Tag="favorites" Click="OnFilterChipClick"
                          Padding="14,4" CornerRadius="14" FontSize="12"/>
            <ToggleButton x:Name="ChipAssigned"  Content="Assigned"  Tag="assigned"  Click="OnFilterChipClick"
                          Padding="14,4" CornerRadius="14" FontSize="12"/>

            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- ═══════════ Grid + sidebar ═══════════ -->
        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Wallpaper grid -->
            <Grid Grid.Column="0">
                <StackPanel x:Name="EmptyState"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="10"
                            Visibility="Collapsed">
                    <FontIcon Glyph="&#xE8B7;" FontSize="48"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="No wallpapers here" FontSize="16" HorizontalAlignment="Center"/>
                    <TextBlock Text="Try a different filter or add a folder."
                               FontSize="12"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- Folder Browser View (Side-by-side) -->
                <Grid x:Name="FolderViewPanel" Visibility="Collapsed" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Folder Tree on the left -->
                    <ListView x:Name="FolderTreeView" Grid.Column="0" Margin="0,0,12,0" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OnFolderTreeClick">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <ListViewItemPresenter
                                                ContentTransitions="{TemplateBinding ContentTransitions}"
                                                SelectionCheckMarkVisualEnabled="False"
                                                PointerOverBackground="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                SelectedBackground="{ThemeResource AccentFillColorSecondaryBrush}"
                                                SelectedPointerOverBackground="{ThemeResource AccentFillColorTertiaryBrush}"
                                                PressedBackground="{ThemeResource SubtleFillColorTertiaryBrush}"
                                                SelectedPressedBackground="{ThemeResource AccentFillColorSecondaryBrush}"
                                                CornerRadius="6" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:FolderDisplayItem">
                                <StackPanel Orientation="Horizontal" Spacing="12" Padding="12,8">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Files in selected folder on the right -->
                    <GridView x:Name="FileListView"
                              Grid.Column="1"
                              SelectionMode="Single"
                              IsItemClickEnabled="True"
                              ItemClick="OnFileItemClick"
                              HorizontalAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.HorizontalScrollMode="Disabled">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal"
                                               ItemWidth="212"
                                               ItemHeight="214"/>
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>

                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="local:WallpaperItem">
                                <Grid Width="204" Height="206" Margin="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="140"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.RowSpan="2"
                                            CornerRadius="8"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"/>

                                    <Border Grid.Row="0"
                                            Margin="1"
                                            CornerRadius="7,7,0,0"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <Grid>
                                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}"
                                                   Visibility="{x:Bind ThumbnailVisibility, Mode=OneWay}"
                                                   Stretch="UniformToFill"/>

                                            <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Spacing="5"
                                                        Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}">
                                                <FontIcon Glyph="{x:Bind FileTypeGlyph}"
                                                          FontSize="32"
                                                          HorizontalAlignment="Center"
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="No thumbnail"
                                                           FontSize="11"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>

                                            <ProgressRing IsActive="True"
                                                          Width="28"
                                                          Height="28"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Visibility="{x:Bind LoadingVisibility, Mode=OneWay}"/>

                                            <Border Background="{ThemeResource OverlayScrimBrush}"
                                                    Visibility="{x:Bind MissingOverlayVisibility, Mode=OneWay}">
                                                <StackPanel HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Spacing="4">
                                                    <FontIcon Glyph="&#xE7BA;"
                                                              FontSize="24"
                                                               Foreground="{ThemeResource ErrorTextBrush}"/>
                                                    <TextBlock Text="File missing"
                                                               FontSize="11"
                                                               HorizontalAlignment="Center"
                                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Row="1"
                                                Margin="10,7,10,6"
                                                Spacing="3">
                                        <TextBlock Text="{x:Bind DisplayName}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{x:Bind DisplayName}"/>
                                        <TextBlock Text="{x:Bind MetaLine}"
                                                   FontSize="10"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Grid>

                <GridView x:Name="WallpaperGrid"
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          ItemClick="OnWallpaperItemClick">

                    <!-- Group style removed for flat grid -->

                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"
                                           ItemWidth="240"
                                           ItemHeight="220"/>
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>

                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="local:WallpaperItem">
                            <Grid Margin="4" Width="232" Height="212">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Thumbnail + overlays -->
                                <Border Grid.Row="0"
                                        CornerRadius="10,10,0,0"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <Grid>
                                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}"
                                               Stretch="UniformToFill"/>

                                        <!-- Loading placeholder -->
                                        <ProgressRing IsActive="True"
                                                      Width="32" Height="32"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Visibility="{x:Bind LoadingVisibility, Mode=OneWay}"/>

                                        <!-- Missing-file overlay -->
                                                <Border Background="{ThemeResource OverlayScrimBrush}"
                                                Visibility="{x:Bind MissingOverlayVisibility, Mode=OneWay}">
                                            <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Spacing="4">
                                                <FontIcon Glyph="&#xE7BA;" FontSize="26" Foreground="{ThemeResource ErrorTextBrush}"/>
                                                <TextBlock Text="File missing"
                                                           FontSize="11"
                                                           HorizontalAlignment="Center"
                                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Live2D badge -->
                                        <Border HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Margin="8"
                                                Padding="6,2"
                                                CornerRadius="4"
                                                 Background="{ThemeResource LiveContentBadgeBrush}"
                                                Visibility="{x:Bind Live2DBadgeVisibility, Mode=OneWay}">
                                            <TextBlock Text="Live2D" FontSize="10" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                        </Border>

                                        <!-- Favorite star -->
                                        <Button HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="8"
                                                Padding="8"
                                                CornerRadius="16"
                                                 Background="{ThemeResource OverlayButtonBrush}"
                                                BorderThickness="0"
                                                Tag="{x:Bind}"
                                                Click="OnFavoriteClick"
                                                ToolTipService.ToolTip="Toggle favorite">
                                            <FontIcon Glyph="{x:Bind FavoriteGlyph, Mode=OneWay}"
                                                      FontSize="16"
                                                      Foreground="{x:Bind FavoriteColor, Mode=OneWay}"/>
                                        </Button>

                                        <!-- Assignment badges -->
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="4"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Bottom"
                                                    Margin="8">
                                            <Border Padding="5,2" CornerRadius="3"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    Visibility="{x:Bind M1BadgeVisibility, Mode=OneWay}">
                                                 <TextBlock Text="M1" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                            </Border>
                                            <Border Padding="5,2" CornerRadius="3"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    Visibility="{x:Bind M2BadgeVisibility, Mode=OneWay}">
                                                <TextBlock Text="M2" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                            </Border>
                                            <Border Padding="5,2" CornerRadius="3"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    Visibility="{x:Bind BothBadgeVisibility, Mode=OneWay}">
                                                <TextBlock Text="Both" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                            </Border>
                                            <Border Padding="5,2" CornerRadius="3"
                                                     Background="{ThemeResource LockBadgeBrush}"
                                                    Visibility="{x:Bind LockBadgeVisibility, Mode=OneWay}">
                                                <TextBlock Text="Lock" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Footer: name + compact meta -->
                                <Border Grid.Row="1"
                                        Padding="10,8"
                                        CornerRadius="0,0,10,10"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind DisplayName}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1"/>
                                        <TextBlock Text="{x:Bind MetaLine, Mode=OneWay}"
                                                   FontSize="10"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>

            <!-- Right column: settings sidebar OR detail pane -->
            <Border x:Name="SidebarBorder"
                    Grid.Column="1"
                    CornerRadius="10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="16" Spacing="14">

                        <!-- Empty state -->
                        <StackPanel x:Name="SidebarNoSelection"
                                    Spacing="8"
                                    Padding="0,40,0,0">
                            <FontIcon Glyph="&#xE7C5;"
                                      FontSize="32"
                                      HorizontalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="Select a wallpaper"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Choose a tile to preview it and apply it to a target."
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <!-- Selected wallpaper content -->
                        <StackPanel x:Name="SidebarContent"
                                    Spacing="14"
                                    Visibility="Collapsed">

                            <StackPanel Spacing="2">
                                <TextBlock x:Name="SidebarFileName"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="SidebarFileMeta"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <Border CornerRadius="8"
                                    Height="120"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <Image x:Name="SidebarPreview" Stretch="UniformToFill"/>
                            </Border>

                            <!-- Missing file warning -->
                            <Border x:Name="MissingFileWarning"
                                    Visibility="Collapsed"
                                    Padding="10"
                                    CornerRadius="6"
                                    Background="{ThemeResource ErrorFillBrush}"
                                    BorderBrush="{ThemeResource ErrorStrokeBrush}"
                                    BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource ErrorTextBrush}"/>
                                        <TextBlock Text="File not found"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Text="This file has moved or been deleted. Point Strata at its new location to keep it in the library."
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <Button Content="Locate file…"
                                            Click="OnLocateFileClick"
                                            HorizontalAlignment="Left"
                                            Padding="10,4"
                                            FontSize="11"/>
                                </StackPanel>
                            </Border>

                            <!-- Scope: Desktop / Lock Screen -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="Apply to"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Border CornerRadius="6"
                                        Padding="2"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Grid ColumnSpacing="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton x:Name="ScopeDesktop"
                                                      Grid.Column="0"
                                                      Content="Desktop"
                                                      Tag="desktop"
                                                      IsChecked="True"
                                                      Click="OnScopeClick"
                                                      HorizontalAlignment="Stretch"
                                                      HorizontalContentAlignment="Center"
                                                      CornerRadius="4"
                                                      Padding="0,6"
                                                      MinWidth="0"/>
                                        <ToggleButton x:Name="ScopeLock"
                                                      Grid.Column="1"
                                                      Content="Lock Screen"
                                                      Tag="lock"
                                                      Click="OnScopeClick"
                                                      HorizontalAlignment="Stretch"
                                                      HorizontalContentAlignment="Center"
                                                      CornerRadius="4"
                                                      Padding="0,6"
                                                      MinWidth="0"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Monitor target row (shared: Desktop + Lock) -->
                            <StackPanel x:Name="MonitorTargetsSection" Spacing="6">
                                <TextBlock x:Name="TargetSectionLabel"
                                           Text="Monitor target"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Grid ColumnSpacing="6" RowSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <ToggleButton x:Name="TargetM1"
                                                  Grid.Row="0" Grid.Column="0"
                                                  Content="Monitor 1"
                                                  Tag="0"
                                                  Click="OnTargetClick"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Center"
                                                  Padding="0,8"/>
                                    <ToggleButton x:Name="TargetM2"
                                                  Grid.Row="0" Grid.Column="1"
                                                  Content="Monitor 2"
                                                  Tag="1"
                                                  Click="OnTargetClick"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Center"
                                                  Padding="0,8"/>
                                    <ToggleButton x:Name="TargetBoth"
                                                  Grid.Row="1" Grid.Column="0"
                                                  Content="Both"
                                                  Tag="all"
                                                  Click="OnTargetClick"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Center"
                                                  Padding="0,8"/>
                                    <ToggleButton x:Name="TargetSpan"
                                                  Grid.Row="1" Grid.Column="1"
                                                  Content="Span"
                                                  Tag="span"
                                                  IsEnabled="False"
                                                  Click="OnTargetClick"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Center"
                                                  Padding="0,8"
                                                  ToolTipService.ToolTip="Coming soon"/>
                                </Grid>
                                <TextBlock x:Name="SpanHint"
                                           Text="Span (one continuous image across all monitors) is coming soon."
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <!-- Single apply button -->
                            <Button x:Name="ApplyButton"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="OnApplyClick"
                                    Padding="0,10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE768;" FontSize="14"/>
                                    <TextBlock x:Name="ApplyButtonText"
                                               Text="Apply to Both monitors"
                                               FontSize="13"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="PreviewButton"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Click="OnPreviewClick"
                                    Padding="0,10"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7B3;" FontSize="14"/>
                                    <TextBlock x:Name="PreviewButtonText"
                                               Text="Preview"
                                               FontSize="13"/>
                                </StackPanel>
                            </Button>

                            <!-- Confirmation / error line -->
                            <TextBlock x:Name="ApplyStatusText"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed"/>

                            <!-- Details -->
                            <Button HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Click="OnShowDetailsClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE946;" FontSize="13"/>
                                    <TextBlock Text="View details" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <local:WallpaperDetailPane x:Name="DetailPane"
                                       Grid.Column="1"
                                       Visibility="Collapsed"/>
        </Grid>

        <!-- Custom Preview Overlay -->
        <Grid x:Name="PreviewOverlay"
              Grid.RowSpan="4"
              Visibility="Collapsed"
              Background="{ThemeResource OverlayScrimBrush}"
              Canvas.ZIndex="100">
            <!-- 16:9 Dialog Box -->
            <Border Width="960" Height="540"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Padding="16,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12,12,0,0">
                        <TextBlock x:Name="PreviewOverlayTitle" Text="Preview" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </Grid>

                    <!-- Video area -->
                    <Grid Grid.Row="1" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                        <MediaPlayerElement x:Name="PreviewMediaPlayer"
                                            AreTransportControlsEnabled="False"
                                            AutoPlay="True"
                                            Stretch="UniformToFill"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"/>

                        <!-- Monitor Label -->
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                            Padding="8,4" CornerRadius="4" Background="{ThemeResource OverlayButtonBrush}">
                            <TextBlock x:Name="PreviewOverlayLabel" Text="Monitor" FontSize="11" Foreground="{ThemeResource PreviewOverlayTextBrush}"/>
                        </Border>

                        <!-- Clock overlay -->
                        <Grid x:Name="PreviewOverlayClock" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32.4*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="67.6*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="PreviewOverlayTime" Text="12:00" 
                                           FontSize="56" FontWeight="SemiBold" 
                                           Foreground="{ThemeResource PreviewOverlayTextBrush}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="PreviewOverlayDate" Text="Monday, April 28" 
                                           FontSize="16" Foreground="{ThemeResource PreviewOverlayTextBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Footer with Close button -->
                    <Grid Grid.Row="2" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="0,0,12,12">
                        <Button Content="Close"
                                HorizontalAlignment="Center"
                                Padding="48,8"
                                Click="OnPreviewOverlayCloseClick"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>