<Page
    x:Class="Blueprint.ControlPanel.LockPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="24,20,24,20">
        <StackPanel Spacing="16" HorizontalAlignment="Stretch">

            <!-- ═══════════ Header ═══════════ -->
            <StackPanel Spacing="4">
                <TextBlock Text="Lock Screen" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Customize your lock screen wallpaper and behavior."
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- ═══════════ 2-column grid ═══════════ -->
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- ─────────── COL 1: Wallpaper card ─────────── -->
                <Border Grid.Column="0"
                        Padding="16"
                        CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Lock Screen Wallpaper"
                                   FontSize="14" FontWeight="SemiBold"/>

                        <!-- Target selector -->
                        <Border CornerRadius="6"
                                Padding="2"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Grid ColumnSpacing="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="LockTargetM1"
                                              Grid.Column="0"
                                              Content="Monitor 1"
                                              Tag="0"
                                              IsChecked="True"
                                              Click="OnLockTargetClick"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Center"
                                              CornerRadius="4"
                                              Padding="0,6"
                                              MinWidth="0"
                                              FontSize="11"/>
                                <ToggleButton x:Name="LockTargetM2"
                                              Grid.Column="1"
                                              Content="Monitor 2"
                                              Tag="1"
                                              Click="OnLockTargetClick"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Center"
                                              CornerRadius="4"
                                              Padding="0,6"
                                              MinWidth="0"
                                              FontSize="11"/>
                                <ToggleButton x:Name="LockTargetBoth"
                                              Grid.Column="2"
                                              Content="Both"
                                              Tag="all"
                                              Click="OnLockTargetClick"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Center"
                                              CornerRadius="4"
                                              Padding="0,6"
                                              MinWidth="0"
                                              FontSize="11"/>
                            </Grid>
                        </Border>

                        <Border CornerRadius="8"
                                Height="320"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <Grid>
                                <!-- Single-monitor / same-image preview -->
                                <Grid x:Name="SinglePreview">
                                    <Image x:Name="LockWallpaperPreview"
                                           Stretch="UniformToFill"/>
                                    <Border x:Name="LockPreviewDimOverlay"
                                             Background="{ThemeResource OverlayScrimBrush}"
                                            Visibility="Collapsed"/>
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="1"
                                                IsHitTestVisible="False">
                                        <TextBlock x:Name="LockPreviewClockTime"
                                                   Text="—:—"
                                                   FontSize="28"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                    Foreground="{ThemeResource PreviewOverlayTextBrush}"/>
                                        <TextBlock x:Name="LockPreviewClockDate"
                                                   Text="—"
                                                   FontSize="10"
                                                   HorizontalAlignment="Center"
                                                    Foreground="{ThemeResource PreviewOverlayTextBrush}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Per-monitor preview (different wallpapers) -->
                                <Grid x:Name="DualPreview"
                                      Visibility="Collapsed"
                                      ColumnSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" CornerRadius="6"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <Grid>
                                            <Image x:Name="LockWallpaperPreviewM1"
                                                   Stretch="Uniform"/>
                                            <Border x:Name="LockPreviewDimOverlayM1"
                                                     Background="{ThemeResource OverlayScrimBrush}"
                                                    Visibility="Collapsed"/>
                                            <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Spacing="1"
                                                        IsHitTestVisible="False">
                                                <TextBlock x:Name="LockPreviewClockTimeM1"
                                                           Text="—:—"
                                                           FontSize="22"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                            Foreground="{ThemeResource PreviewOverlayTextBrush}"/>
                                                <TextBlock x:Name="LockPreviewClockDateM1"
                                                           Text="—"
                                                           FontSize="9"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{ThemeResource PreviewOverlayTextBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="1" CornerRadius="6"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <Grid>
                                            <Image x:Name="LockWallpaperPreviewM2"
                                                   Stretch="Uniform"/>
                                            <Border x:Name="LockPreviewDimOverlayM2"
                                                     Background="{ThemeResource OverlayScrimBrush}"
                                                    Visibility="Collapsed"/>
                                            <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Spacing="1"
                                                        IsHitTestVisible="False">
                                                <TextBlock x:Name="LockPreviewClockTimeM2"
                                                           Text="—:—"
                                                           FontSize="22"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{ThemeResource PreviewOverlayTextBrush}"/>
                                                <TextBlock x:Name="LockPreviewClockDateM2"
                                                           Text="—"
                                                           FontSize="9"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{ThemeResource PreviewOverlayTextBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <StackPanel Spacing="2">
                            <TextBlock x:Name="LockWallpaperNameText"
                                       Text="(none)"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="LockWallpaperMetaText"
                                       Text="—"
                                       FontSize="10"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <Button HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="OnBrowseLockWallpaperClick"
                                Padding="0,10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="14"/>
                                <TextBlock Text="Apply to Lock Screen" FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <Button HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Click="OnLockPreviewNowClick"
                                Padding="0,10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7B3;" FontSize="14"/>
                                <TextBlock Text="Preview Lock Now" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ─────────── COL 2: Behavior + Display ─────────── -->
                <StackPanel Grid.Column="1" Spacing="14">

                    <!-- Behavior Settings -->
                    <Border Padding="16" CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Behavior Settings"
                                       FontSize="14" FontWeight="SemiBold"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Enable Lock Screen Wallpaper" FontSize="12"/>
                                    <TextBlock Text="Show the overlay after idle."
                                               FontSize="10"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="LockEnabledToggle"
                                              Grid.Column="1"
                                              Toggled="OnLockEnabledToggled"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Pause on Lock Screen" FontSize="12"/>
                                    <TextBlock Text="Freeze desktop playback while the overlay is up."
                                               FontSize="10"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="LockPauseToggle"
                                              Grid.Column="1"
                                              Toggled="OnLockPauseToggled"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Dim When Locked" FontSize="12"/>
                                    <TextBlock Text="Apply a soft darkening layer under the clock."
                                               FontSize="10"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="LockDimToggle"
                                              Grid.Column="1"
                                              Toggled="OnLockDimToggled"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Show Clock" FontSize="12"/>
                                    <TextBlock Text="Display time and date over the wallpaper."
                                               FontSize="10"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="LockClockToggle"
                                              Grid.Column="1"
                                              Toggled="OnLockClockToggled"/>
                            </Grid>

                            <StackPanel Spacing="4" Margin="0,6,0,0">
                                <TextBlock Text="Idle timeout" FontSize="12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="LockIdleSlider"
                                            Grid.Column="0"
                                            Minimum="1" Maximum="60"
                                            StepFrequency="1"
                                            Value="5"/>
                                    <TextBlock x:Name="LockIdleValueText"
                                               Grid.Column="1"
                                               MinWidth="52"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               TextAlignment="Right"
                                               Text="5 min"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Display Options -->
                    <Border Padding="16" CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Display Options"
                                       FontSize="14" FontWeight="SemiBold"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="180"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Fill Mode"
                                           VerticalAlignment="Center"
                                           FontSize="12"/>
                                <ComboBox x:Name="LockFillModeCombo"
                                          Grid.Column="1"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="OnLockFillModeChanged">
                                    <ComboBoxItem Content="Fill"/>
                                    <ComboBoxItem Content="Fit"/>
                                    <ComboBoxItem Content="Stretch"/>
                                    <ComboBoxItem Content="Center"/>
                                </ComboBox>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="180"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Lock Screen FPS"
                                           VerticalAlignment="Center"
                                           FontSize="12"/>
                                <ComboBox x:Name="LockFpsCombo"
                                          Grid.Column="1"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="OnLockFpsChanged">
                                    <ComboBoxItem Content="15 FPS"/>
                                    <ComboBoxItem Content="20 FPS"/>
                                    <ComboBoxItem Content="30 FPS"/>
                                    <ComboBoxItem Content="60 FPS"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>

            <!-- ═══════════ Expert: Day/Night for the lock overlay ═══════════ -->
            <!-- ═══════════ Day / Night (desktop) — preserved ═══════════ -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="0,0,0,10">
                <Expander Header="Day / Night (desktop wallpaper)"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="16">

                    <StackPanel Spacing="12">

                        <TextBlock Text="Choose what plays behind the clock. You can reuse the desktop Day / Night videos, or set an independent schedule and videos just for the lock overlay."
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <ToggleSwitch x:Name="LockDnEnabledToggle"
                                  Header="Use a separate Day / Night schedule"
                                  Toggled="OnLockDnEnabledToggled"/>

                    <StackPanel x:Name="LockDnBody" Spacing="10" Margin="0,8,0,0">
                        <RadioButton x:Name="LockDnModeManual"
                                     GroupName="LockDnMode"
                                     Content="Manual time"
                                     Checked="OnLockDnModeChanged"/>
                        <RadioButton x:Name="LockDnModeSunrise"
                                     GroupName="LockDnMode"
                                     Content="Sunrise / Sunset"
                                     Checked="OnLockDnModeChanged"/>
                        <RadioButton x:Name="LockDnModePrayer"
                                     GroupName="LockDnMode"
                                     Content="Prayer times"
                                     Checked="OnLockDnModeChanged"/>

                        <StackPanel x:Name="LockDnManualPanel" Spacing="8" Margin="28,4,0,0"
                                    Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Day starts at" VerticalAlignment="Center" Width="120"/>
                                <TimePicker x:Name="LockDnManualDayStart"
                                            ClockIdentifier="24HourClock"
                                            TimeChanged="OnLockDnManualTimeChanged"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Night starts at" VerticalAlignment="Center" Width="120"/>
                                <TimePicker x:Name="LockDnManualNightStart"
                                            ClockIdentifier="24HourClock"
                                            TimeChanged="OnLockDnManualTimeChanged"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="LockDnSunrisePanel" Spacing="6" Margin="28,4,0,0"
                                    Visibility="Collapsed">
                            <TextBlock Text="Location is shared with Settings → Day / Night."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="11"/>
                            <TextBlock x:Name="LockDnSunriseInfoText"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="11"/>
                        </StackPanel>

                        <StackPanel x:Name="LockDnPrayerPanel" Spacing="8" Margin="28,4,0,0"
                                    Visibility="Collapsed">
                            <TextBlock Text="Location and calculation method are shared with Settings → Day / Night."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="11"/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Duha offset (min)"
                                           VerticalAlignment="Center" Width="140"/>
                                <NumberBox x:Name="LockDnDuhaOffsetBox"
                                           Value="20"
                                           Minimum="0" Maximum="180"
                                           SpinButtonPlacementMode="Inline"/>
                            </StackPanel>
                            <TextBlock x:Name="LockDnTodayText"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                            <TextBlock Text="Day video:" VerticalAlignment="Center" Width="100"/>
                            <TextBlock x:Name="LockDnDayVideoText" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                            <Button Content="Browse..." Click="OnLockDnBrowseDayVideoClick"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Night video:" VerticalAlignment="Center" Width="100"/>
                            <TextBlock x:Name="LockDnNightVideoText" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                            <Button Content="Browse..." Click="OnLockDnBrowseNightVideoClick"/>
                        </StackPanel>
                    </StackPanel>

                    <Border x:Name="LockFallbackSection"
                            Margin="0,8,0,0" Padding="16,12"
                            CornerRadius="6"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="When the toggle above is OFF"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="The lock overlay follows the desktop Day / Night schedule."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"/>

                            <CheckBox x:Name="LockUseDayNightVideosCheckbox"
                                      Content="Use the desktop Day / Night videos"/>

                            <StackPanel x:Name="LockSeparateVideosPanel" Spacing="10" Margin="28,4,0,0"
                                        Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="Day video:" VerticalAlignment="Center" Width="100"/>
                                    <TextBlock x:Name="LockDayVideoText" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                                    <Button Content="Browse..." Click="OnLockBrowseDayVideoClick"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="Night video:" VerticalAlignment="Center" Width="100"/>
                                    <TextBlock x:Name="LockNightVideoText" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                                    <Button Content="Browse..." Click="OnLockBrowseNightVideoClick"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Expander>
            </Border>

            <!-- ═══════════ Security: Mode + Password ═══════════ -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="0,0,0,10">
                <Expander Header="Security — dismiss mode &amp; password"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="16">

                    <StackPanel Spacing="12">

                        <RadioButton x:Name="LockModeScreensaver"
                                 GroupName="LockMode"
                                 Content="Screensaver — any mouse/keyboard input dismisses instantly (no security)"
                                 Checked="OnLockModeChanged"/>
                    <RadioButton x:Name="LockModePassword"
                                 GroupName="LockMode"
                                 Content="Locked — password required to dismiss (primary monitor only)"
                                 Checked="OnLockModeChanged"/>

                    <Border x:Name="LockPasswordCard"
                            Padding="16" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Visibility="Collapsed">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Password" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="Used to dismiss the overlay in Locked mode. Stored as a SHA-256 hash in settings.ini. The prompt is only shown on the primary monitor."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"/>

                            <PasswordBox x:Name="LockPasswordBox"
                                         PlaceholderText="New password"
                                         Width="320"
                                         HorizontalAlignment="Left"/>
                            <PasswordBox x:Name="LockPasswordConfirmBox"
                                         PlaceholderText="Confirm password"
                                         Width="320"
                                         HorizontalAlignment="Left"/>

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Content="Save password" Click="OnLockSavePasswordClick"/>
                                <Button x:Name="LockClearPasswordButton"
                                        Content="Clear saved password"
                                        Click="OnLockClearPasswordClick"/>
                            </StackPanel>

                            <TextBlock x:Name="LockPasswordStatusText"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="11"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Expander>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>