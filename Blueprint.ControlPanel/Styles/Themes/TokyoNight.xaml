<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <!-- TOKYO NIGHT DARK -->
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="SystemAccentColor">#7AA2F7</Color>
            <FontFamily x:Key="ThemeFontFamily">ms-appx:///Assets/font/JetBrainsMono-Regular.ttf#JetBrains Mono</FontFamily>
            
            <!-- Backgrounds -->
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#1A1B26"/>
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#16161E"/>
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#1A1B26"/>
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#24283B"/>
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#16161E"/>
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#24283B"/>
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#1A1B26"/>

            <!-- Borders & Dividers -->
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#414868"/>
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#414868"/>
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#414868"/>
            <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="#414868"/>

            <!-- Text -->
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#C0CAF5"/>
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#A9B1D6"/>
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#565F89"/>
            <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#414868"/>

            <!-- Controls -->
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#24283B"/>
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#1F2335"/>
            <SolidColorBrush x:Key="ButtonBackground" Color="#24283B"/>
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#292E42"/>
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1F2335"/>
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#414868"/>
            <SolidColorBrush x:Key="ButtonForeground" Color="#C0CAF5"/>
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#15161E"/>
            <SolidColorBrush x:Key="StatusOfflineBrush" Color="#565F89"/>
            <SolidColorBrush x:Key="StatusOnlineBrush" Color="#9ECE6A"/>
            <SolidColorBrush x:Key="WarningBrush" Color="#E0AF68"/>
            <SolidColorBrush x:Key="ErrorFillBrush" Color="#33F7768E"/>
            <SolidColorBrush x:Key="ErrorStrokeBrush" Color="#FFF7768E"/>
            <SolidColorBrush x:Key="ErrorTextBrush" Color="#FFF7768E"/>
            <SolidColorBrush x:Key="OverlayScrimBrush" Color="#B3000000"/>
            <SolidColorBrush x:Key="OverlayButtonBrush" Color="#AA000000"/>
            <SolidColorBrush x:Key="TransparentBrush" Color="#00000000"/>
            <SolidColorBrush x:Key="PreviewPlaceholderBrush" Color="#414868"/>
            <SolidColorBrush x:Key="PreviewPlaceholderTextBrush" Color="#A9B1D6"/>
            <SolidColorBrush x:Key="PreviewOverlayBrush" Color="#D2000000"/>
            <SolidColorBrush x:Key="PreviewOverlaySecondaryBrush" Color="#5A000000"/>
            <SolidColorBrush x:Key="PreviewOverlayTextBrush" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="PreviewOverlayMutedTextBrush" Color="#B0FFFFFF"/>
            <SolidColorBrush x:Key="PreviewOverlaySubtleTextBrush" Color="#CCFFFFFF"/>
            <SolidColorBrush x:Key="PreviewSeparatorBrush" Color="#50FFFFFF"/>
            <SolidColorBrush x:Key="FavoriteBrush" Color="#E0AF68"/>
            <SolidColorBrush x:Key="LockBadgeBrush" Color="#CCF7768E"/>
            <SolidColorBrush x:Key="LiveContentBadgeBrush" Color="#CC9ECE6A"/>
            <SolidColorBrush x:Key="ComboBoxBackground" Color="#24283B"/>
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#414868"/>
            <SolidColorBrush x:Key="ComboBoxForeground" Color="#C0CAF5"/>
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#7AA2F7"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#7AA2F7"/>
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="#7AA2F7"/>

            <!-- Navigation -->
            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#C0CAF5"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#24283B"/>
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#7AA2F7"/>
        </ResourceDictionary>

