        <!-- ROSÉ PINE MAIN (Dark) -->
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="SystemAccentColor">#C4A7E7</Color>
            <FontFamily x:Key="ThemeFontFamily">ms-appx:///Assets/font/FiraCode-Regular.ttf#Fira Code</FontFamily>
            
            <!-- Backgrounds -->
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#191724"/>
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#1F1D2E"/>
