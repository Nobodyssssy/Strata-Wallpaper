<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <!-- AURA DARK -->
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="SystemAccentColor">#4A90E2</Color>
            <FontFamily x:Key="ThemeFontFamily">Cascadia Code</FontFamily>
            
            <!-- Backgrounds -->
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#15141B"/>
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#15141B"/>
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#15141B"/>
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#1D1C25"/>
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#15141B"/>
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#1D1C25"/>
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#15141B"/>

            <!-- Borders & Dividers -->
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#2D2C3A"/>
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#2D2C3A"/>
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#2D2C3A"/>
            <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="#2D2C3A"/>

            <!-- Text -->
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#EDECEE"/>
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#A5A3B3"/>
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#6E6B80"/>
            <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#4A4858"/>

            <!-- Controls (Buttons, Combos, Toggles) -->
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#242330"/>
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#1D1C25"/>
            <SolidColorBrush x:Key="ButtonBackground" Color="#242330"/>
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2D2C3A"/>
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#15141B"/>
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#2D2C3A"/>
            <SolidColorBrush x:Key="ButtonForeground" Color="#EDECEE"/>
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="StatusOfflineBrush" Color="#6B7280"/>
            <SolidColorBrush x:Key="StatusOnlineBrush" Color="#22C55E"/>
            <SolidColorBrush x:Key="WarningBrush" Color="#FACC15"/>
            <SolidColorBrush x:Key="ErrorFillBrush" Color="#33FF6B6B"/>
            <SolidColorBrush x:Key="ErrorStrokeBrush" Color="#FFFF6B6B"/>
            <SolidColorBrush x:Key="ErrorTextBrush" Color="#FFFF7C7C"/>
            <SolidColorBrush x:Key="OverlayScrimBrush" Color="#B3000000"/>
            <SolidColorBrush x:Key="OverlayButtonBrush" Color="#AA000000"/>
            <SolidColorBrush x:Key="TransparentBrush" Color="#00000000"/>
            <SolidColorBrush x:Key="PreviewPlaceholderBrush" Color="#5A5A5A"/>
            <SolidColorBrush x:Key="PreviewPlaceholderTextBrush" Color="#8C8C8C"/>
            <SolidColorBrush x:Key="PreviewOverlayBrush" Color="#D2000000"/>
            <SolidColorBrush x:Key="PreviewOverlaySecondaryBrush" Color="#5A000000"/>
            <SolidColorBrush x:Key="PreviewOverlayTextBrush" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="PreviewOverlayMutedTextBrush" Color="#B0FFFFFF"/>
            <SolidColorBrush x:Key="PreviewOverlaySubtleTextBrush" Color="#CCFFFFFF"/>
            <SolidColorBrush x:Key="PreviewSeparatorBrush" Color="#50FFFFFF"/>
            <SolidColorBrush x:Key="FavoriteBrush" Color="#FACC15"/>
            <SolidColorBrush x:Key="LockBadgeBrush" Color="#CCE72E5A"/>
            <SolidColorBrush x:Key="LiveContentBadgeBrush" Color="#CC00C8B4"/>
            <SolidColorBrush x:Key="ComboBoxBackground" Color="#242330"/>
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#2D2C3A"/>
            <SolidColorBrush x:Key="ComboBoxForeground" Color="#EDECEE"/>
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#4A90E2"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#4A90E2"/>
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="#4A90E2"/>

            <!-- Navigation -->
            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#EDECEE"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#242330"/>
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#4A90E2"/>
        </ResourceDictionary>

        <!-- AURA LIGHT -->
        <ResourceDictionary x:Key="Light">
            <Color x:Key="SystemAccentColor">#4A90E2</Color>
            <FontFamily x:Key="ThemeFontFamily">Cascadia Code</FontFamily>
            
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#F5F4F8"/>
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#EBEAEF"/>
