            <SolidColorBrush x:Key="ButtonForeground" Color="#1A1921"/>
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="StatusOfflineBrush" Color="#6B7280"/>
            <SolidColorBrush x:Key="StatusOnlineBrush" Color="#16A34A"/>
            <SolidColorBrush x:Key="WarningBrush" Color="#A16207"/>
            <SolidColorBrush x:Key="ErrorFillBrush" Color="#33DC2626"/>
            <SolidColorBrush x:Key="ErrorStrokeBrush" Color="#FFDC2626"/>
            <SolidColorBrush x:Key="ErrorTextBrush" Color="#FFB91C1C"/>
            <SolidColorBrush x:Key="OverlayScrimBrush" Color="#66000000"/>
            <SolidColorBrush x:Key="OverlayButtonBrush" Color="#AA000000"/>
            <SolidColorBrush x:Key="TransparentBrush" Color="#00000000"/>
            <SolidColorBrush x:Key="PreviewPlaceholderBrush" Color="#D1D1D1"/>
            <SolidColorBrush x:Key="PreviewPlaceholderTextBrush" Color="#6E6E6E"/>
            <SolidColorBrush x:Key="PreviewOverlayBrush" Color="#D2000000"/>
            <SolidColorBrush x:Key="PreviewOverlaySecondaryBrush" Color="#5A000000"/>
            <SolidColorBrush x:Key="PreviewOverlayTextBrush" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="PreviewOverlayMutedTextBrush" Color="#B0FFFFFF"/>
            <SolidColorBrush x:Key="PreviewOverlaySubtleTextBrush" Color="#CCFFFFFF"/>
            <SolidColorBrush x:Key="PreviewSeparatorBrush" Color="#50FFFFFF"/>
            <SolidColorBrush x:Key="FavoriteBrush" Color="#A16207"/>
            <SolidColorBrush x:Key="LockBadgeBrush" Color="#CCD20F39"/>
            <SolidColorBrush x:Key="LiveContentBadgeBrush" Color="#CC00897B"/>
            <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#DCDAE5"/>
            <SolidColorBrush x:Key="ComboBoxForeground" Color="#1A1921"/>
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#4A90E2"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#4A90E2"/>
            <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="#4A90E2"/>

            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#1A1921"/>
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#DCDAE5"/>
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#4A90E2"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>