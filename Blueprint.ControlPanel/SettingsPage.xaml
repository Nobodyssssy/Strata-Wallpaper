<Page
    x:Class="Blueprint.ControlPanel.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="24,20,24,20">
        <StackPanel Spacing="16" MaxWidth="1200" HorizontalAlignment="Left">

            <!-- ═══════════ Header ═══════════ -->
            <StackPanel Spacing="4">
                <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="General settings, appearance and system options."
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- ═══════════ 3-column grid ═══════════ -->
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ─────────── COL 1: Appearance + Window Behavior ─────────── -->
                <StackPanel Grid.Column="0" Spacing="14">

                    <!-- Appearance -->
                    <Border Padding="18" CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Appearance" FontSize="14" FontWeight="SemiBold"/>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Base Theme" FontSize="12"/>
                                <ComboBox x:Name="BaseThemeCombo" HorizontalAlignment="Stretch" SelectionChanged="OnBaseThemeChanged">
                                    <ComboBoxItem Content="Aura" Tag="Aura"/>
                                    <ComboBoxItem Content="Catppuccin" Tag="Catppuccin"/>
                                    <ComboBoxItem Content="Dracula" Tag="Dracula"/>
                                    <ComboBoxItem Content="Tokyo Night" Tag="Tokyo Night"/>
                                    <ComboBoxItem Content="Rosé Pine" Tag="Rosé Pine"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                                <ToggleSwitch x:Name="UseThemeFontToggle" Header="Use theme font" Toggled="OnUseThemeFontToggled" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Color Scheme" FontSize="12"/>
                                <ComboBox x:Name="VariantCombo" HorizontalAlignment="Stretch" SelectionChanged="OnVariantChanged">
                                    <ComboBoxItem Content="System"/>
                                    <ComboBoxItem Content="Dark"/>
                                    <ComboBoxItem Content="Light"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Accent Color" FontSize="12"/>
                                <StackPanel x:Name="AccentSwatchPanel"
                                            Orientation="Horizontal"
                                            Spacing="8"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Window Behavior -->
                    <Border Padding="18" CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Window Behavior"
                                       FontSize="14" FontWeight="SemiBold"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Start with Windows" FontSize="12"/>
                                    <TextBlock Text="Launch Strata when you sign in."
                                               FontSize="10"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="AutoStartToggle"
                                              Grid.Column="1"
                                              Toggled="OnAutoStartToggled"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Minimize to tray" FontSize="12"/>
                                    <TextBlock Text="Keep the engine running in the background."
                                               FontSize="10"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="MinimizeToTrayToggle"
                                              Grid.Column="1"
                                              Toggled="OnMinimizeToTrayToggled"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ─────────── COL 2: Close Action + Auto-start info ─────────── -->
                <StackPanel Grid.Column="1" Spacing="14">

                    <!-- Close Action -->
                    <Border Padding="18" CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Close Action"
                                       FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="What should happen when you close the control panel window?"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                            <RadioButton x:Name="CloseAsk"
                                         GroupName="CloseAction"
                                         Content="Ask me each time"
                                         Checked="OnCloseActionChanged"/>
                            <RadioButton x:Name="CloseExit"
                                         GroupName="CloseAction"
                                         Content="Exit Strata completely"
                                         Checked="OnCloseActionChanged"/>
                            <RadioButton x:Name="CloseTray"
                                         GroupName="CloseAction"
                                         Content="Minimize to tray (engine keeps running)"
                                         Checked="OnCloseActionChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- Auto-start help -->
                    <Border Padding="18" CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Auto-Start"
                                       FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Launching at login uses a HKCU Run entry — no admin permissions required and no Scheduled Task. Disabling it removes the entry immediately."
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ─────────── COL 3: Storage + About ─────────── -->
                <StackPanel Grid.Column="2" Spacing="14">

                    <!-- Storage & Logs -->
                    <Border Padding="18" CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Storage &amp; Logs"
                                       FontSize="14" FontWeight="SemiBold"/>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Settings file"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="SettingsPathText"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           TextWrapping="Wrap"/>
                                <Button Content="Open Settings Folder"
                                        Margin="0,4,0,0"
                                        Click="OnOpenSettingsClick"/>
                            </StackPanel>

                            <StackPanel Spacing="4" Margin="0,6,0,0">
                                <TextBlock Text="Log file"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="LogPathText"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           TextWrapping="Wrap"/>
                                <Button Content="Open Log File"
                                        Margin="0,4,0,0"
                                        Click="OnOpenLogClick"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- About -->
                    <Border Padding="18" CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="About" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Strata Wallpaper v0.1.0"
                                       FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="Lightweight Windows 11 live wallpaper engine."
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="No telemetry. No analytics. Your data stays on your PC."
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ═══════════ Day / Night (desktop) ═══════════ -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="0,0,0,10">
                <Expander Header="Day / Night (desktop wallpaper)"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="16">

                    <StackPanel Spacing="12">

                        <TextBlock Text="Switch the desktop wallpaper automatically based on the time of day."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"/>

                    <ToggleSwitch x:Name="DayNightEnabledToggle"
                                  Header="Enable Day / Night switching"
                                  Toggled="OnDayNightEnabledToggled"/>

                    <StackPanel Orientation="Vertical" Spacing="6" Margin="0,6,0,0">
                        <RadioButton x:Name="DnModeManual"
                                     GroupName="DnMode"
                                     Content="Manual time"
                                     Checked="OnDnModeChanged"/>
                        <RadioButton x:Name="DnModeSunrise"
                                     GroupName="DnMode"
                                     Content="Sunrise / Sunset (real solar math)"
                                     Checked="OnDnModeChanged"/>
                        <RadioButton x:Name="DnModePrayer"
                                     GroupName="DnMode"
                                     Content="Prayer times (Aladhan API, cached weekly)"
                                     Checked="OnDnModeChanged"/>
                    </StackPanel>

                    <!-- Manual -->
                    <StackPanel x:Name="DnManualPanel" Spacing="8" Margin="28,4,0,0"
                                Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Day starts at" VerticalAlignment="Center" Width="120"/>
                            <TimePicker x:Name="DnManualDayStart"
                                        ClockIdentifier="24HourClock"
                                        TimeChanged="OnDnManualTimeChanged"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Night starts at" VerticalAlignment="Center" Width="120"/>
                            <TimePicker x:Name="DnManualNightStart"
                                        ClockIdentifier="24HourClock"
                                        TimeChanged="OnDnManualTimeChanged"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Sunrise -->
                    <StackPanel x:Name="DnSunrisePanel" Spacing="8" Margin="28,4,0,0"
                                Visibility="Collapsed">
                        <TextBlock Text="Uses your latitude / longitude — no internet required."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="11"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Latitude" VerticalAlignment="Center" Width="80"/>
                            <TextBox x:Name="DnLatBox" Width="140"
                                     LostFocus="OnDnLatLngChanged"/>
                            <TextBlock Text="Longitude" VerticalAlignment="Center"
                                       Width="80" Margin="12,0,0,0"/>
                            <TextBox x:Name="DnLngBox" Width="140"
                                     LostFocus="OnDnLatLngChanged"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Prayer -->
                    <StackPanel x:Name="DnPrayerPanel" Spacing="8" Margin="28,4,0,0"
                                Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBox x:Name="DnCityBox" PlaceholderText="City (e.g. Paris)"
                                     Width="220"/>
                            <Button x:Name="DnDetectButton" Content="Detect"
                                    Click="OnDnDetectCityClick"/>
                            <TextBlock x:Name="DnCityResultText"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontSize="11"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Calculation method"
                                       VerticalAlignment="Center" Width="140"/>
                            <ComboBox x:Name="DnMethodCombo" MinWidth="280"
                                      SelectionChanged="OnDnMethodChanged">
                                <ComboBoxItem Content="Muslim World League"/>
                                <ComboBoxItem Content="Umm Al-Qura, Makkah"/>
                                <ComboBoxItem Content="Egyptian General Authority"/>
                                <ComboBoxItem Content="University of Islamic Sciences, Karachi"/>
                                <ComboBoxItem Content="Algerian Ministry of Religious Affairs"/>
                                <ComboBoxItem Content="Union des Organisations Islamiques de France"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Duha offset (min)"
                                       VerticalAlignment="Center" Width="140"/>
                            <NumberBox x:Name="DnDuhaOffsetBox"
                                       Value="20"
                                       Minimum="0" Maximum="180"
                                       SpinButtonPlacementMode="Inline"
                                       ValueChanged="OnDnDuhaOffsetChanged"/>
                        </StackPanel>

                        <TextBlock x:Name="DnTodayText"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="Night video begins at Maghrib. Day video begins at Duha (Sunrise + offset)."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Videos -->
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                        <TextBlock Text="Day video:" VerticalAlignment="Center" Width="100"/>
                        <TextBlock x:Name="DnDayVideoText" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="440"/>
                        <Button Content="Browse..." Click="OnDnBrowseDayVideoClick"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Night video:" VerticalAlignment="Center" Width="100"/>
                        <TextBlock x:Name="DnNightVideoText" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="440"/>
                        <Button Content="Browse..." Click="OnDnBrowseNightVideoClick"/>
                    </StackPanel>
                </StackPanel>
            </Expander>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>