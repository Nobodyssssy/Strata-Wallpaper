<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<RootNamespace>Blueprint.ControlPanel</RootNamespace>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<Platforms>x86;x64;ARM64</Platforms>
		<RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
		<UseWinUI>true</UseWinUI>
		<Nullable>enable</Nullable>
		
		<!-- Required for unpackaged, self-contained apps -->
		<WindowsPackageType>None</WindowsPackageType>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<SelfContained>true</SelfContained>
		
		<!-- Must be true for unpackaged apps to generate the resources.pri file correctly -->
		<EnableMsixTooling>true</EnableMsixTooling>
		
		<!-- The crash culprits -->
		<PublishTrimmed>false</PublishTrimmed>
		<PublishReadyToRun>false</PublishReadyToRun>
		<PublishSingleFile>false</PublishSingleFile>
		<IsTrimmable>false</IsTrimmable>

		<!-- Force the PRI file to be generated -->
		<AppxGenerateProjectPriFile>true</AppxGenerateProjectPriFile>
		<GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
		<AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>

		<ApplicationIcon>Strata.ico</ApplicationIcon>
		<EnableDefaultPageItems>false</EnableDefaultPageItems>
	</PropertyGroup>

	<ItemGroup>
		<Page Include="LockPage.xaml"><Generator>MSBuild:Compile</Generator></Page>
		<Page Include="MainWindow.xaml"><Generator>MSBuild:Compile</Generator></Page>
		<Page Include="HomePage.xaml"><Generator>MSBuild:Compile</Generator></Page>
		<Page Include="LibraryPage.xaml"><Generator>MSBuild:Compile</Generator></Page>
		<Page Include="PerformancePage.xaml"><Generator>MSBuild:Compile</Generator></Page>
		<Page Include="SettingsPage.xaml"><Generator>MSBuild:Compile</Generator></Page>
		<Page Include="WallpaperDetailPane.xaml"><Generator>MSBuild:Compile</Generator></Page>
		
		<!-- Theme files must NOT have the MSBuild:Compile generator -->
		<Page Include="Styles\Themes\Aura.xaml" />
		<Page Include="Styles\Themes\Catppuccin.xaml" />
		<Page Include="Styles\Themes\Dracula.xaml" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Assets\SplashScreen.scale-200.png" />
		<Content Include="Assets\LockScreenLogo.scale-200.png" />
		<Content Include="Assets\Square150x150Logo.scale-200.png" />
		<Content Include="Assets\Square44x44Logo.scale-200.png" />
		<Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
		<Content Include="Assets\StoreLogo.png" />
		<Content Include="Assets\Wide310x150Logo.scale-200.png" />
		<Content Include="Strata.ico">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
	</ItemGroup>

	<ItemGroup>
	  <Content Update="Assets\Roboto-Regular.ttf">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>
</Project>