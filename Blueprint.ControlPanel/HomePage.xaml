<Page
    x:Class="Blueprint.ControlPanel.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Blueprint.ControlPanel"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24,20,24,20" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Home" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="Your wallpapers are running. Manage, customize and enjoy your desktop."
                       FontSize="13"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- ════════════ LEFT: Hero + quick nav + tips ════════════ -->
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          VerticalScrollMode="Auto"
                          HorizontalScrollMode="Disabled">
                <StackPanel Spacing="16">

                    <!-- Hero card -->
                    <Border CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <Grid MinHeight="380">
                            <Grid x:Name="HeroPreviewsHost" ColumnSpacing="0"/>

                            <Button x:Name="ChangeWallpaperButton"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,18,16"
                                Click="OnChangeWallpaperClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                                    <TextBlock Text="Change Wallpaper" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Quick nav cards -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ═══ Wallpapers ═══ -->
                        <Border Grid.Column="0" Padding="16" CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Height="150">
                                    <Border Width="98" Height="80"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="76,58,0,0"
                                        CornerRadius="6"
                                        BorderThickness="1"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <Image x:Name="CardWallThumbB" Stretch="UniformToFill"/>
                                    </Border>
                                    <Border Width="124" Height="108"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        CornerRadius="6"
                                        BorderThickness="1"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <Image x:Name="CardWallThumbA" Stretch="UniformToFill"/>
                                    </Border>
                                </Grid>

                                <FontIcon Grid.Row="1"
                                      Glyph="&#xE8B7;" FontSize="20"
                                      HorizontalAlignment="Left"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>

                                <TextBlock Grid.Row="2"
                                       Text="Wallpapers"
                                       FontWeight="SemiBold" FontSize="14"/>

                                <TextBlock Grid.Row="3"
                                       Text="Manage your library, set favorites and choose what plays."
                                       FontSize="11" TextWrapping="Wrap"
                                       VerticalAlignment="Top"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                <Button Grid.Row="4"
                                    Content="Open Wallpapers"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Padding="10,6"
                                    FontSize="11"
                                    Tag="wallpapers"
                                    Click="OnQuickActionClick"/>
                            </Grid>
                        </Border>

                        <!-- ═══ Performance ═══ -->
                        <Border Grid.Column="1" Padding="16" CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <StackPanel Spacing="8">
                                <Border Height="150"
                                    CornerRadius="6"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <StackPanel VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Spacing="6">
                                        <TextBlock x:Name="CardPerfFps"
                                               Text="—"
                                               FontSize="32"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="CardPerfQuality"
                                               Text="—"
                                               FontSize="14"
                                               HorizontalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <FontIcon Glyph="&#xE9D9;" FontSize="20"
                                      HorizontalAlignment="Left"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Performance" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="Adjust FPS, quality and resource usage."
                                       FontSize="11" TextWrapping="Wrap" Height="46"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Button Content="Open Performance"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Padding="10,6"
                                    FontSize="11"
                                    Tag="performance"
                                    Click="OnQuickActionClick"/>
                            </StackPanel>
                        </Border>

                        <!-- ═══ Lock Screen ═══ -->
                        <Border Grid.Column="2" Padding="16" CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <StackPanel Spacing="8">
                                <Border Height="150"
                                    CornerRadius="6"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <Grid>
                                        <Image x:Name="CardLockThumb" Stretch="UniformToFill"/>
                                        <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="2"
                                                IsHitTestVisible="False">
                                            <TextBlock x:Name="CardLockClockTime"
                                                   Text="—:—"
                                                   FontSize="34"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="White"/>
                                            <TextBlock x:Name="CardLockClockDate"
                                                   Text="—"
                                                   FontSize="11"
                                                   HorizontalAlignment="Center"
                                                   Foreground="White"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <FontIcon Glyph="&#xE72E;" FontSize="20"
                                      HorizontalAlignment="Left"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Lock Screen" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="Customize your lock screen wallpaper and behavior."
                                       FontSize="11" TextWrapping="Wrap" Height="46"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <!-- ADDED STYLE HERE -->
                                <Button Content="Open Lock Screen"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Padding="10,6"
                                    FontSize="11"
                                    Tag="lock"
                                    Click="OnQuickActionClick"/>
                            </StackPanel>
                        </Border>

                        <!-- ═══ Settings ═══ -->
                        <Border Grid.Column="3" Padding="16" CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <StackPanel Spacing="8">
                                <Border Height="150"
                                    CornerRadius="6"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    Padding="14,12">
                                    <StackPanel VerticalAlignment="Center" Spacing="14">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0"
                                                  Glyph="&#xE708;" FontSize="13"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                   Text="Theme" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                   x:Name="CardSettingsTheme"
                                                   Text="—" FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0"
                                                  Glyph="&#xE7E8;" FontSize="13"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                   Text="Auto Start" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                   x:Name="CardSettingsAutoStart"
                                                   Text="—" FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0"
                                                  Glyph="&#xE8BB;" FontSize="13"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                   Text="Close" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                   x:Name="CardSettingsClose"
                                                   Text="—" FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <FontIcon Glyph="&#xE713;" FontSize="20"
                                      HorizontalAlignment="Left"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Settings" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="Themes, accent colors, window behavior."
                                       FontSize="11" TextWrapping="Wrap" Height="46"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <!-- ADDED STYLE HERE -->
                                <Button Content="Open Settings"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Padding="10,6"
                                    FontSize="11"
                                    Tag="settings"
                                    Click="OnQuickActionClick"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ═══ Tips (moved to left column, full width) ═══ -->
                    <Border Padding="16" CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                Width="36" Height="36"
                                CornerRadius="18"
                                Background="{ThemeResource AccentFillColorTertiaryBrush}">
                                <FontIcon Glyph="&#xE82F;" FontSize="16"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            </Border>

                            <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                <TextBlock Text="Tips" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TipText"
                                       Text="Use the Performance tab to find the best balance between smooth playback and low GPU usage."
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Spacing="6">
                                <Ellipse x:Name="TipDot0" Width="6" Height="6" Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
                                <Ellipse x:Name="TipDot1" Width="6" Height="6" Fill="{ThemeResource ControlStrokeColorDefaultBrush}"/>
                                <Ellipse x:Name="TipDot2" Width="6" Height="6" Fill="{ThemeResource ControlStrokeColorDefaultBrush}"/>
                                <Ellipse x:Name="TipDot3" Width="6" Height="6" Fill="{ThemeResource ControlStrokeColorDefaultBrush}"/>
                                <Ellipse x:Name="TipDot4" Width="6" Height="6" Fill="{ThemeResource ControlStrokeColorDefaultBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ════════════ RIGHT: sidebar ════════════ -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">

                    <!-- Engine Status card -->
                    <Border Padding="16" CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Engine Status"
                                       FontSize="13" FontWeight="SemiBold"/>

                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse x:Name="StatusDot"
                                             Width="9" Height="9"
                                             Fill="{ThemeResource StatusOfflineBrush}"
                                             VerticalAlignment="Center"/>
                                    <TextBlock x:Name="StatusLabel"
                                               Text="Engine offline"
                                               FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock x:Name="StatusSubtitle"
                                           Text="Start the engine to display wallpapers."
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="2"
                                            HorizontalAlignment="Center">
                                    <TextBlock x:Name="StatMonitors"
                                               Text="—"
                                               FontSize="20" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Monitors" FontSize="10"
                                               HorizontalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>

                                <Rectangle Grid.Column="1" Width="1"
                                           Fill="{ThemeResource CardStrokeColorDefaultBrush}"
                                           Margin="0,4"/>

                                <StackPanel Grid.Column="2" Spacing="2"
                                            HorizontalAlignment="Center">
                                    <TextBlock x:Name="StatFps"
                                               Text="—"
                                               FontSize="20" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="FPS" FontSize="10"
                                               HorizontalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>

                                <Rectangle Grid.Column="3" Width="1"
                                           Fill="{ThemeResource CardStrokeColorDefaultBrush}"
                                           Margin="0,4"/>

                                <StackPanel Grid.Column="4" Spacing="2"
                                            HorizontalAlignment="Center">
                                    <TextBlock x:Name="StatDisplayMode"
                                               Text="—"
                                               FontSize="20" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Display" FontSize="10"
                                               HorizontalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>

                            <Button x:Name="StartEngineButton"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="OnStartEngineClick"
                                    Visibility="Collapsed"
                                    Padding="0,10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE768;" FontSize="12"/>
                                    <TextBlock Text="Start Engine" FontSize="12"/>
                                </StackPanel>
                            </Button>

                            <Grid x:Name="EngineControlRow"
                                  ColumnSpacing="8"
                                  Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="PauseButton"
                                        Grid.Column="0"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Click="OnPauseResumeClick"
                                        Padding="0,10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon x:Name="PauseIcon" Glyph="&#xE769;" FontSize="12"/>
                                        <TextBlock x:Name="PauseLabel" Text="Pause" FontSize="12"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="TurnOffButton"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Click="OnTurnOffOnClick"
                                        Padding="0,10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon x:Name="PowerIcon" Glyph="&#xE7E8;" FontSize="12"/>
                                        <TextBlock x:Name="PowerLabel" Text="Turn Off" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Quick Actions card -->
                    <Border Padding="16" CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Quick Actions" FontSize="13" FontWeight="SemiBold"
                                       Margin="0,0,0,4"/>

                            <Button HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Padding="8,8"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="OnOpenWallpaperFolderClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="14"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Open Wallpaper Folder"
                                               FontSize="12" Margin="10,0,0,0"
                                               VerticalAlignment="Center"/>
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="11"
                                              VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                            </Button>

                            <Button HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Padding="8,8"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="OnOpenLogsClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE9D9;" FontSize="14"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Open Logs"
                                               FontSize="12" Margin="10,0,0,0"
                                               VerticalAlignment="Center"/>
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="11"
                                              VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Fused Favorites / Recents card -->
                    <Border Padding="16" CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="10">

                            <!-- Toggle row -->
                            <Border CornerRadius="6"
                                    Padding="2"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Grid ColumnSpacing="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="TabFavorites"
                                                  Grid.Column="0"
                                                  Content="Favorites"
                                                  IsChecked="True"
                                                  Click="OnCollectionsTabClick"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Center"
                                                  CornerRadius="4"
                                                  Padding="0,6"
                                                  MinWidth="0"/>
                                    <ToggleButton x:Name="TabRecents"
                                                  Grid.Column="1"
                                                  Content="Recent"
                                                  Click="OnCollectionsTabClick"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Center"
                                                  CornerRadius="4"
                                                  Padding="0,6"
                                                  MinWidth="0"/>
                                </Grid>
                            </Border>

                            <!-- Lists -->
                            <StackPanel x:Name="FavoritesList" Spacing="6"/>
                            <TextBlock x:Name="FavoritesEmpty"
                                       Text="Star a wallpaper from the Wallpapers page to see it here."
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                            <StackPanel x:Name="RecentList" Spacing="6"
                                        Visibility="Collapsed"/>
                            <TextBlock x:Name="RecentEmpty"
                                       Text="Nothing applied yet."
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="Collapsed"/>

                            <!-- View All -->
                            <Button x:Name="CollectionsViewAllButton"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Padding="6,4"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="OnCollectionsViewAllClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="View All"
                                               FontSize="12"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <FontIcon Glyph="&#xE76C;" FontSize="10"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>