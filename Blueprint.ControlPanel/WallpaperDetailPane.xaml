<UserControl
    x:Class="Blueprint.ControlPanel.WallpaperDetailPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Blueprint.ControlPanel"
    Background="Transparent">

    <Border CornerRadius="10"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ═══ Header ═══ -->
            <Grid Grid.Row="0" Padding="12,10" ColumnSpacing="8"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Padding="6"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnCloseClick"
                        ToolTipService.ToolTip="Back to list">
                    <FontIcon Glyph="&#xE72B;" FontSize="14"/>
                </Button>

                <TextBlock Grid.Column="1"
                           Text="Details"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="2"
                        Padding="6"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnCloseClick"
                        ToolTipService.ToolTip="Close">
                    <FontIcon Glyph="&#xE711;" FontSize="12"/>
                </Button>
            </Grid>

            <!-- ═══ Scroll body ═══ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="14" Spacing="14">

                    <!-- Preview + favorite -->
                    <Border CornerRadius="8"
                            Height="150"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <Grid>
                            <Image x:Name="DetailPreview" Stretch="UniformToFill"/>

                            <Button x:Name="FavoriteButton"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="8"
                                    Padding="8"
                                    CornerRadius="16"
                                    Background="{ThemeResource OverlayButtonBrush}"
                                    BorderThickness="0"
                                    Click="OnFavoriteClick"
                                    ToolTipService.ToolTip="Toggle favorite">
                                <FontIcon x:Name="FavoriteIcon"
                                          Glyph="&#xE734;"
                                          FontSize="16"
                                          Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Filename + folder -->
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="DetailFileName"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="DetailFolder"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Missing banner -->
                    <Border x:Name="MissingBanner"
                            Visibility="Collapsed"
                            Padding="10"
                            CornerRadius="6"
                            Background="{ThemeResource ErrorFillBrush}"
                            BorderBrush="{ThemeResource ErrorStrokeBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource ErrorTextBrush}"/>
                                <TextBlock Text="File not found"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="The file has moved or been deleted."
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Button Content="Locate file…"
                                    Click="OnLocateFileClick"
                                    HorizontalAlignment="Left"
                                    Padding="10,4"
                                    FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <!-- Assignment badges -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Assigned to"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Border x:Name="BadgeM1" Padding="7,3" CornerRadius="4"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed">
                                <TextBlock Text="Monitor 1" FontSize="10"
                                           FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                            </Border>
                            <Border x:Name="BadgeM2" Padding="7,3" CornerRadius="4"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed">
                                <TextBlock Text="Monitor 2" FontSize="10"
                                           FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                            </Border>
                            <Border x:Name="BadgeBoth" Padding="7,3" CornerRadius="4"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed">
                                <TextBlock Text="Both" FontSize="10"
                                           FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                            </Border>
                            <Border x:Name="BadgeLock" Padding="7,3" CornerRadius="4"
                                    Background="{ThemeResource ErrorTextBrush}" Visibility="Collapsed">
                                <TextBlock Text="Lock Screen" FontSize="10"
                                           FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                            </Border>
                            <TextBlock x:Name="NoAssignmentText"
                                       Text="Not assigned"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Metadata -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="File info"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Grid ColumnSpacing="12" RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Resolution" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DetailResolution"
                                       FontSize="11" FontWeight="SemiBold"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Duration" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DetailDuration"
                                       FontSize="11" FontWeight="SemiBold"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Size" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DetailSize"
                                       FontSize="11" FontWeight="SemiBold"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Type" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DetailType"
                                       FontSize="11" FontWeight="SemiBold"/>
                        </Grid>
                    </StackPanel>

                    <!-- Tags -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Tags"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <GridView x:Name="TagsGrid"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False"
                                  HorizontalAlignment="Stretch">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal"
                                                   MaximumRowsOrColumns="1"/>
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="Margin" Value="0,0,4,4"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                    <Setter Property="MinWidth" Value="0"/>
                                </Style>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,3" CornerRadius="11"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{Binding}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"/>
                                            <Button Padding="0"
                                                    Width="16" Height="16"
                                                    MinWidth="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Tag="{Binding}"
                                                    Click="OnRemoveTagClick"
                                                    ToolTipService.ToolTip="Remove tag">
                                                <FontIcon Glyph="&#xE711;" FontSize="8"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NewTagBox"
                                     Grid.Column="0"
                                     PlaceholderText="Add tag…"
                                     FontSize="11"
                                     KeyDown="OnNewTagKeyDown"/>
                            <Button Grid.Column="1"
                                    Content="Add"
                                    FontSize="11"
                                    Padding="10,4"
                                    Click="OnAddTagClick"/>
                        </Grid>

                        <StackPanel x:Name="SuggestionsSection"
                                    Spacing="4"
                                    Visibility="Collapsed">
                            <TextBlock Text="Suggested from filename"
                                       FontSize="10"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ItemsRepeater x:Name="SuggestionsRepeater">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinItemWidth="50"
                                                       MinItemHeight="24"
                                                       MinRowSpacing="4"
                                                       MinColumnSpacing="4"
                                                       ItemsStretch="None"/>
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}"
                                                FontSize="10"
                                                Padding="8,2"
                                                CornerRadius="10"
                                                Tag="{Binding}"
                                                Click="OnAddSuggestedTagClick"/>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </StackPanel>

                    <!-- Source URL -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Source URL"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SourceUrlBox"
                                     Grid.Column="0"
                                     PlaceholderText="https://…"
                                     FontSize="11"
                                     TextChanged="OnSourceUrlChanged"
                                     LostFocus="OnSourceUrlLostFocus"/>
                            <Button x:Name="OpenSourceButton"
                                    Grid.Column="1"
                                    Content="Open"
                                    FontSize="11"
                                    Padding="10,4"
                                    IsEnabled="False"
                                    Click="OnOpenSourceClick"
                                    ToolTipService.ToolTip="Open this URL in your browser"/>
                        </Grid>
                        <TextBlock Text="Opens in your browser. Strata does not download from this URL."
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Author -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Author"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBox x:Name="AuthorBox"
                                 PlaceholderText="Optional"
                                 FontSize="11"
                                 LostFocus="OnAuthorLostFocus"/>
                    </StackPanel>

                    <!-- License -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="License"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBox x:Name="LicenseBox"
                                 PlaceholderText="Optional — e.g. CC BY 4.0"
                                 FontSize="11"
                                 LostFocus="OnLicenseLostFocus"/>
                        <TextBlock Text="Stored locally only. Strata does not infer a license."
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Notes -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Notes"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBox x:Name="NotesBox"
                                 PlaceholderText="Optional"
                                 FontSize="11"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="72"
                                 LostFocus="OnNotesLostFocus"/>
                    </StackPanel>

                    <TextBlock Text="Fields are saved automatically as you edit."
                               FontSize="10"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>